# ============================================
# RAG-KW 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写实际的配置值
# 3. .env 文件已被 .gitignore 忽略，不会提交到代码库
# ============================================

# ---------- LLM 配置（智谱 AI）----------
# 从智谱 AI 平台获取 API Key: https://open.bigmodel.cn/
LLM_API_KEY=your-zhipu-ai-api-key-here

# LLM 基础 URL（通常不需要修改）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 嵌入模型名称
LLM_EMBEDDING_MODEL=embedding-3

# 向量维度（必须与模型匹配）
LLM_EMBEDDING_DIMENSIONS=512

# 对话模型名称，默认为 glm-4.7-flash免费模型
LLM_CHAT_MODEL=glm-4.7-flash

# ---------- 数据库配置 ----------
# MySQL 密码
MYSQL_PASSWORD=your-password

# ---------- 可选：其他服务配置 ----------
# Elasticsearch 地址
# ELASTICSEARCH_URI=http://localhost:9200

# Redis 地址
# REDIS_HOST=localhost
# REDIS_PORT=6379
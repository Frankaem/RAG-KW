{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1
  },
  "mappings": {
    "properties": {
      "sessionId": {
        "type": "keyword"
      },
      "userId": {
        "type": "long"
      },
      "summary": {
        "type": "text",
        "analyzer": "ik_smart"
      },
      "vector": {
        "type": "dense_vector",
        "dims": 512,
        "similarity": "cosine"
      },
      "questionPreview": {
        "type": "text"
      },
      "answerPreview": {
        "type": "text"
      },
      "createdAt": {
        "type": "date"
      }
    }
  }
}